# Clarinet project — environment variables.
# Copy to .env, then uncomment and fill in what this server needs.
# Environment variables win over settings.toml and settings.custom.toml.
# Leave a line commented rather than empty: an empty value is still a value.

# --- Database (PostgreSQL) ---
# CLARINET_DATABASE_NAME=my_project
# CLARINET_DATABASE_HOST=localhost
# CLARINET_DATABASE_PORT=5432
# CLARINET_DATABASE_USERNAME=clarinet
# CLARINET_DATABASE_PASSWORD=

# --- Security ---
# CLARINET_SECRET_KEY=
# While CLARINET_ADMIN_PASSWORD is unset and debug = true (settings.toml),
# `clarinet db init` and startup create the admin account with password admin123.
# CLARINET_ADMIN_PASSWORD=

# --- Storage ---
# CLARINET_STORAGE_PATH=/srv/clarinet/my_project

# --- RabbitMQ (pipeline) ---
# CLARINET_RABBITMQ_HOST=localhost
# CLARINET_RABBITMQ_LOGIN=clarinet
# CLARINET_RABBITMQ_PASSWORD=

# --- DICOM (this node) / PACS ---
# CLARINET_DICOM_AET=CLARINET
# CLARINET_DICOM_PORT=11112
# CLARINET_PACS_AET=ORTHANC
# CLARINET_PACS_HOST=
# CLARINET_PACS_PORT=4242
